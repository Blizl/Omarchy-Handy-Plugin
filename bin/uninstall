#!/usr/bin/env bash
set -euo pipefail

PLUGIN_ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)"
# Resolved from the installed plugin directory.
# shellcheck disable=SC1091
source "$PLUGIN_ROOT/lib/transaction.sh"
# Resolved from the installed plugin directory.
# shellcheck disable=SC1091
source "$PLUGIN_ROOT/lib/privilege.sh"

privilege_require_non_root "${BASH_SOURCE[0]}" || exit 1

STATE_ROOT="${BLIZL_HANDY_STATE_DIR:-$HOME/.local/state/blizl.handy}"
INSTALL_FILE="$STATE_ROOT/install.json"
HANDY_WAS_RUNNING=false
HANDY_RESTARTED=false
VOXTYPE_HOTKEY_DISABLED=false

restart_handy_if_needed() {
  if [[ "$HANDY_WAS_RUNNING" == true && "$HANDY_RESTARTED" != true ]]; then
    handy --start-hidden >/dev/null 2>&1 &
    for _ in {1..30}; do
      pgrep -x handy >/dev/null 2>&1 && break
      sleep 0.1
    done
    HANDY_RESTARTED=true
  fi
}

trap restart_handy_if_needed EXIT

if [[ ! -f "$INSTALL_FILE" ]]; then
  echo "No blizl.handy setup transaction is installed."
  exit 0
fi

transaction_dir="$(jq -er '.transaction' "$INSTALL_FILE")"
VOXTYPE_HOTKEY_DISABLED="$(jq -r '.voxtypeHotkeyDisabled // false' "$INSTALL_FILE")"
# install.json is user-writable, so the recorded path is untrusted input. A bare
# prefix test would accept "$STATE_ROOT/backups/../../.."; compare canonical
# paths so the check actually means "inside the backups directory".
backups_root="$(realpath -m -- "$STATE_ROOT/backups")" || {
  echo "Could not resolve the backups directory: $STATE_ROOT/backups" >&2
  exit 1
}
transaction_dir="$(realpath -m -- "$transaction_dir")" || {
  echo "Could not resolve the transaction path" >&2
  exit 1
}
[[ "$transaction_dir" == "$backups_root"/* ]] || {
  echo "Refusing unexpected transaction path: $transaction_dir" >&2
  exit 1
}
[[ -f "$transaction_dir/targets.tsv" ]] || {
  echo "Transaction backup is incomplete: $transaction_dir" >&2
  exit 1
}

if pgrep -x handy >/dev/null 2>&1; then
  HANDY_WAS_RUNNING=true
  pkill -x handy
fi

runtime_root="${BLIZL_HANDY_RUNTIME_DIR:-${XDG_RUNTIME_DIR:-/tmp}/blizl-handy}"
if [[ -f "$runtime_root/watcher.pid" ]]; then
  watcher_pid="$(<"$runtime_root/watcher.pid")"
  if [[ "$watcher_pid" =~ ^[0-9]+$ && "$watcher_pid" != "$$" ]]; then
    kill "$watcher_pid" >/dev/null 2>&1 || true
  fi
  rm -f -- "$runtime_root/watcher.pid"
fi
rm -f -- "$runtime_root/recording-armed"

transaction_restore "$transaction_dir"
if [[ "$VOXTYPE_HOTKEY_DISABLED" == true ]] && command -v systemctl >/dev/null 2>&1 &&
  systemctl --user is-active voxtype.service >/dev/null 2>&1; then
  systemctl --user restart voxtype.service >/dev/null
fi
rm -f -- "$INSTALL_FILE"
restart_handy_if_needed

if command -v omarchy >/dev/null 2>&1; then
  omarchy restart shell >/dev/null 2>&1 || true
fi

if [[ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]] && command -v hyprctl >/dev/null; then
  hyprctl reload >/dev/null
  errors="$(hyprctl configerrors)"
  [[ -z "$errors" ]] || {
    echo "Hyprland reports configuration errors after restoration: $errors" >&2
    exit 1
  }
fi

echo "Restored bindings, shell layout, Handy shortcut settings, and autostart state."
echo "Handy, its models, and VoxType were not removed."
