#!/usr/bin/env python3
"""
Ephemeral evdev chord watcher for push-to-talk dictation.
Monitors /dev/input/event* keyboard devices while recording is active.
The moment ANY modifier or base key in the chord is released, triggers
handy-trigger release and terminates immediately.
"""

import sys
import os
import signal
import select
import subprocess
import time
import json

try:
    import evdev
    from evdev import ecodes
except ImportError:
    # If evdev is not installed, exit cleanly with code 2
    sys.exit(2)

TIMEOUT_SECONDS = 60.0

