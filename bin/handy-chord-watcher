def _resolve_single_token(tok):
    """Resolves a single token string to a list of evdev keycodes."""
    if not tok:
        return []
    tok_clean = tok.strip().upper()
    tok_no_under = tok_clean.replace('_', '').replace('-', '')

    if tok_clean in SPECIAL_BASE_KEYS:
        return list(SPECIAL_BASE_KEYS[tok_clean])
    if tok_no_under in SPECIAL_BASE_KEYS:
        return list(SPECIAL_BASE_KEYS[tok_no_under])
    if tok_clean in MODIFIER_MAP:
        return list(MODIFIER_MAP[tok_clean])
    if tok_no_under in MODIFIER_MAP:
        return list(MODIFIER_MAP[tok_no_under])

    for candidate in (tok_clean, tok_no_under):
        key_attr = 'KEY_' + candidate
        if hasattr(ecodes, key_attr):
            return [getattr(ecodes, key_attr)]
        if candidate.startswith('KEY_') and hasattr(ecodes, candidate):
            return [getattr(ecodes, candidate)]

    return []


def parse_shortcut(shortcut_str):
    """
    Parses a shortcut string (e.g. 'ALT + SPACE', 'SUPER + CTRL + X', 'F9', 'LEFTALT')
    into (base_codes, modifier_groups).
    Returns (list of base keycodes, list of modifier keycode lists).
    """
    if not shortcut_str or not str(shortcut_str).strip():
        return [], []

    cleaned = str(shortcut_str).strip()
    raw_tokens = [t.strip() for t in cleaned.split('+')]

    tokens = []
    for t in raw_tokens:
        if t:
            tokens.append(t)
        elif tokens and tokens[-1]:
            # Trailing or intermediate '+' token (e.g. 'CTRL + +')
            tokens.append('PLUS')

    if not tokens:
        return [], []

    base_name = tokens[-1]
    mod_names = tokens[:-1]

    base_codes = _resolve_single_token(base_name)
    modifier_groups = []
    for mod in mod_names:
        codes = _resolve_single_token(mod)
        if codes:
            modifier_groups.append(codes)

    return base_codes, modifier_groups


def find_keyboard_devices(target_codes):
    """Discovers and returns all open evdev InputDevice instances supporting target codes."""
    keyboards = []
    try:
        device_paths = evdev.list_devices()
    except Exception:
        return []

    for path in device_paths:
        try:
            dev = evdev.InputDevice(path)
            caps = dev.capabilities()
            if ecodes.EV_KEY in caps:
                supported_keys = set(caps[ecodes.EV_KEY])
                if any(code in supported_keys for code in target_codes):
                    keyboards.append(dev)
                else:
                    dev.close()
            else:
                dev.close()
        except Exception:
            continue
    return keyboards


def trigger_release(trigger_bin):
    """Triggers release in the helper script cleanly and non-blocking."""
    try:
        subprocess.run(
            [trigger_bin, "release"],
            check=False,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            close_fds=True
        )
    except Exception:
        pass


def main():
    if len(sys.argv) < 2:
        print("Usage: handy-chord-watcher <shortcut> [trigger_bin] | --parse <shortcut>", file=sys.stderr)
        sys.exit(64)

    # CLI parse mode for unit testing & introspection
    if sys.argv[1] in ('--parse', '-p', '--test-parse'):
        if len(sys.argv) < 3:
            sys.exit(64)
        shortcut_str = sys.argv[2]
        base_codes, modifier_groups = parse_shortcut(shortcut_str)
        all_target_codes = set(base_codes)
        for group in modifier_groups:
            all_target_codes.update(group)

        res = {
            "shortcut": shortcut_str,
            "base_codes": sorted(base_codes),
            "modifier_groups": [sorted(g) for g in modifier_groups],
            "all_target_codes": sorted(all_target_codes),
            "valid": bool(all_target_codes),
        }
        print(json.dumps(res))
        sys.exit(0 if all_target_codes else 1)

    shortcut_str = sys.argv[1]
    trigger_bin = sys.argv[2] if len(sys.argv) > 2 else os.path.join(os.path.dirname(os.path.abspath(__file__)), "handy-trigger")

    base_codes, modifier_groups = parse_shortcut(shortcut_str)
    all_target_codes = set(base_codes)
    for group in modifier_groups:
        all_target_codes.update(group)

    if not all_target_codes:
        sys.exit(1)

    # Clean signal handling for termination
    def handle_signal(sig, frame):
        sys.exit(0)

    signal.signal(signal.SIGTERM, handle_signal)
    signal.signal(signal.SIGINT, handle_signal)

    devices = find_keyboard_devices(all_target_codes)
    if not devices:
        # No matching keyboard device found or accessible
        sys.exit(3)

    dev_fd_map = {dev.fd: dev for dev in devices}
    start_time = time.time()

    # Initial check: if chord was already active or already released
    has_seen_active = False
    for dev in devices:
        try:
            active = set(dev.active_keys())
            if any(code in active for code in all_target_codes):
                has_seen_active = True
                break
        except Exception:
            pass

    try:
        while True:
            elapsed = time.time() - start_time
            remaining = TIMEOUT_SECONDS - elapsed
            if remaining <= 0:
                # Clean timeout termination - ensure release is triggered so recording stops
                trigger_release(trigger_bin)
                return 0

            # select.select across all keyboard device file descriptors
            try:
                r, _, _ = select.select(list(dev_fd_map.keys()), [], [], min(remaining, 0.5))
            except (select.error, OSError, ValueError):
                break

            if r:
                for fd in r:
                    dev = dev_fd_map.get(fd)
                    if not dev:
                        continue
                    try:
                        for event in dev.read():
                            if event.type == ecodes.EV_KEY:
                                if event.code in all_target_codes:
                                    if event.value == 0:  # Key Up / Released
                                        # Immediate release triggering when ANY key in the active chord is released
                                        trigger_release(trigger_bin)
                                        return 0
                                    elif event.value in (1, 2):  # Key Down / Hold
                                        has_seen_active = True
                    except (OSError, IOError):
                        pass
            else:
                # select timeout slice expired (0.5s with no event) -> active keys polling check
                any_active = False
                for dev in devices:
                    try:
                        active = set(dev.active_keys())
                        if any(code in active for code in all_target_codes):
                            any_active = True
                            has_seen_active = True
                            break
                    except Exception:
                        pass

                # If we saw active keys previously, but now NONE are active across all devices,
                # the chord was released (e.g. event dropped or consumed)
                if has_seen_active and not any_active:
                    trigger_release(trigger_bin)
                    return 0

    finally:
        for dev in devices:
            try:
                dev.close()
            except Exception:
                pass

    return 0


if __name__ == '__main__':
    sys.exit(main())
