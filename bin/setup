#!/usr/bin/env bash
set -euo pipefail

PLUGIN_ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)"
# Resolved from the installed plugin directory.
# shellcheck disable=SC1091
source "$PLUGIN_ROOT/lib/bindings.sh"
# Resolved from the installed plugin directory.
# shellcheck disable=SC1091
source "$PLUGIN_ROOT/lib/handy-settings.sh"
# Resolved from the installed plugin directory.
# shellcheck disable=SC1091
source "$PLUGIN_ROOT/lib/transaction.sh"
# Resolved from the installed plugin directory.
# shellcheck disable=SC1091
source "$PLUGIN_ROOT/lib/voxtype-settings.sh"
# Resolved from the installed plugin directory.
# shellcheck disable=SC1091
source "$PLUGIN_ROOT/lib/shell-settings.sh"
# Resolved from the installed plugin directory.
# shellcheck disable=SC1091
source "$PLUGIN_ROOT/lib/privilege.sh"

privilege_require_non_root "${BASH_SOURCE[0]}" || exit 1

STATE_ROOT="${BLIZL_HANDY_STATE_DIR:-$HOME/.local/state/blizl.handy}"
BINDINGS_FILE="${HYPR_BINDINGS_FILE:-$HOME/.config/hypr/bindings.lua}"
AUTOSTART_FILE="${HANDY_AUTOSTART_FILE:-$HOME/.config/autostart/Handy.desktop}"
SETTINGS_FILE="$(handy_settings_file)"
SHELL_FILE="$(shell_settings_file)"
INSTALL_FILE="$STATE_ROOT/install.json"
VOXTYPE_BINDINGS_FILE="${VOXTYPE_BINDINGS_FILE:-${OMARCHY_PATH:-/usr/share/omarchy}/default/hypr/bindings/voxtype.lua}"
VOXTYPE_CONFIG="${VOXTYPE_CONFIG_FILE:-$HOME/.config/voxtype/config.toml}"
HANDY_WAS_RUNNING=false
HANDY_STARTED_BY_SETUP=false
HANDY_INSTALLED=false
VOXTYPE_REMOVED=false
VOXTYPE_RECOVERY_ACTIVE=false
VOXTYPE_RECOVERY=''
VOXTYPE_HOTKEY_DISABLED=false
VOXTYPE_WAS_ACTIVE=false
CREATED_TRANSACTION=false
COMMITTED=false
DICTATION_TEST_STARTED=false
TEST_WINDOW_PID=''
TEST_WINDOW_DIR=''
TEST_WINDOW_PID_FILE=''

say() { printf '%s\n' "$*"; }
fail() {
  printf 'setup: %s\n' "$*" >&2
  exit 1
}

voxtype_is_available() {
  if [[ -n "${BLIZL_HANDY_VOXTYPE_PRESENT:-}" ]]; then
    [[ "$BLIZL_HANDY_VOXTYPE_PRESENT" == true ]]
  else
    command -v voxtype >/dev/null 2>&1
  fi
}

confirm() {
  local prompt="$1"
  local default="${2:-no}"
  local answer suffix

  if [[ -n "${BLIZL_HANDY_CONFIRM:-}" ]]; then
    [[ "$BLIZL_HANDY_CONFIRM" == yes ]]
    return
  fi
  [[ -t 0 ]] || return 1
  [[ "$default" == yes ]] && suffix='[Y/n]' || suffix='[y/N]'
  read -r -p "$prompt $suffix " answer
  answer="${answer:-$default}"
  [[ "$answer" =~ ^[Yy]([Ee][Ss])?$ ]]
}

cleanup() {
  local status=$? rollback_complete=true handy_restored=false handy_stopped=true helper_pid=''
  if [[ -n "$TEST_WINDOW_PID_FILE" && -f "$TEST_WINDOW_PID_FILE" ]]; then
    helper_pid="$(<"$TEST_WINDOW_PID_FILE")"
    if [[ "$helper_pid" =~ ^[0-9]+$ && "$helper_pid" != "$$" ]]; then
      kill "$helper_pid" >/dev/null 2>&1 || true
      wait "$helper_pid" >/dev/null 2>&1 || true
    fi
    TEST_WINDOW_PID_FILE=''
  fi
  if [[ -n "$TEST_WINDOW_PID" ]]; then
    kill "$TEST_WINDOW_PID" >/dev/null 2>&1 || true
    wait "$TEST_WINDOW_PID" >/dev/null 2>&1 || true
    TEST_WINDOW_PID=''
  fi
  if [[ -n "$TEST_WINDOW_DIR" && "$TEST_WINDOW_DIR" == "$STATE_ROOT"/dictation-test.* ]]; then
    rm -rf -- "$TEST_WINDOW_DIR"
    TEST_WINDOW_DIR=''
  fi
  local runtime_root="${BLIZL_HANDY_RUNTIME_DIR:-${XDG_RUNTIME_DIR:-/tmp}/blizl-handy}"
  if [[ -f "$runtime_root/watcher.pid" ]]; then
    local watcher_pid
    watcher_pid="$(<"$runtime_root/watcher.pid")"
    if [[ "$watcher_pid" =~ ^[0-9]+$ && "$watcher_pid" != "$$" ]]; then
      kill "$watcher_pid" >/dev/null 2>&1 || true
    fi
    rm -f -- "$runtime_root/watcher.pid"
  fi
  rm -f -- "$runtime_root/recording-armed"
  if ((status != 0)) && [[ "$CREATED_TRANSACTION" == true && "$COMMITTED" != true ]]; then
    say "Setup failed; restoring plugin-managed files."
    transaction_restore "$TRANSACTION_DIR" || {
      printf 'Setup rollback failed.\n' >&2
      status=1
      rollback_complete=false
    }
    if [[ "$HANDY_STARTED_BY_SETUP" == true ]]; then
      pkill -x handy >/dev/null 2>&1 || true
      for _ in {1..30}; do
        pgrep -x handy >/dev/null 2>&1 || break
        sleep 0.1
      done
      if pgrep -x handy >/dev/null 2>&1; then
        printf 'Could not stop the setup-owned Handy process.\n' >&2
        status=1
        rollback_complete=false
        handy_stopped=false
      fi
    fi
    if [[ "$HANDY_WAS_RUNNING" == true && "$handy_stopped" == true ]]; then
      if pgrep -x handy >/dev/null 2>&1; then
        handy_restored=true
      else
        handy --start-hidden >/dev/null 2>&1 &
        for _ in {1..30}; do
          if pgrep -x handy >/dev/null 2>&1; then
            handy_restored=true
            break
          fi
          sleep 0.1
        done
        if [[ "$handy_restored" != true ]]; then
          printf 'Could not restore the pre-setup Handy process.\n' >&2
          status=1
          rollback_complete=false
        fi
      fi
    fi
    if [[ "$HANDY_INSTALLED" == true ]]; then
      if [[ -n "${BLIZL_HANDY_PKG_DROP_BIN:-}" ]]; then
        "$BLIZL_HANDY_PKG_DROP_BIN" handy-bin >/dev/null 2>&1 || {
          status=1
          rollback_complete=false
        }
      elif command -v omarchy >/dev/null 2>&1; then
        omarchy pkg drop handy-bin >/dev/null 2>&1 || {
          status=1
          rollback_complete=false
        }
      fi
    fi
    if [[ "$VOXTYPE_RECOVERY_ACTIVE" == true || "$VOXTYPE_REMOVED" == true ]]; then
      voxtype_restore || {
        status=1
        rollback_complete=false
      }
    fi
    if [[ "$VOXTYPE_HOTKEY_DISABLED" == true && "$VOXTYPE_WAS_ACTIVE" == true ]]; then
      systemctl --user restart voxtype.service >/dev/null 2>&1 || {
        status=1
        rollback_complete=false
      }
    fi
    if [[ "$DICTATION_TEST_STARTED" == true ]]; then
      if [[ "$rollback_complete" != true ]]; then
        printf 'Setup rollback was incomplete; attempting plugin removal anyway.\n' >&2
      fi
      remove_plugin_after_failed_test || status=1
    fi
  fi
  return "$status"
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

ensure_input_permissions() {
  [[ "${BLIZL_HANDY_SKIP_INPUT_CHECK:-false}" == true ]] && return 0
  # Identify the account from the kernel, never from $USER. Both values below
  # are interpolated into privileged sudo commands, and `setfacl -m` parses
  # commas as additional ACL entries, so an attacker-controlled name could
  # append an entry such as `o::rw` and hand every local account read/write
  # access to all input devices. $USER is ordinary environment state that any
  # same-user process can poison; `id` reports the real credentials.
  local current_user current_uid
  current_user="$(id -un)" || fail "could not determine the current user name"
  current_uid="$(id -u)" || fail "could not determine the current user id"
  [[ "$current_user" =~ ^[A-Za-z_][A-Za-z0-9_.-]*\$?$ ]] ||
    fail "unsupported characters in the current user name: $current_user"
  [[ "$current_uid" =~ ^[0-9]+$ ]] || fail "unsupported current user id: $current_uid"
  local in_input_group=false
  if groups "$current_user" 2>/dev/null | grep -qw "input"; then
    in_input_group=true
  elif id -nG "$current_user" 2>/dev/null | grep -qw "input"; then
    in_input_group=true
  fi

  if [[ "$in_input_group" != true ]]; then
    if [[ "${BLIZL_HANDY_NONINTERACTIVE:-false}" != true ]]; then
      say "Handy requires Linux evdev input permissions to detect the global dictation shortcut."
      if confirm "Add user '$current_user' to the 'input' group?" yes; then
        if command -v sudo >/dev/null 2>&1; then
          sudo usermod -aG input -- "$current_user" || true
        fi
      else
        say "Skipping group update. Shortcut detection may require manual evdev permissions."
      fi
    elif [[ "${BLIZL_HANDY_CONFIRM:-}" == yes ]]; then
      if command -v sudo >/dev/null 2>&1; then
        sudo usermod -aG input -- "$current_user" || true
      fi
    fi
  fi

  if compgen -G "/dev/input/event*" >/dev/null 2>&1; then
    if ! test -r /dev/input/event0 2>/dev/null; then
      if command -v sudo >/dev/null 2>&1 && command -v setfacl >/dev/null 2>&1; then
        if [[ "${BLIZL_HANDY_NONINTERACTIVE:-false}" != true ]]; then
          if confirm "Grant current user read permissions to /dev/input/event* via setfacl for this session?" yes; then
            sudo setfacl -m "u:${current_uid}:r" /dev/input/event* 2>/dev/null || true
          fi
        elif [[ "${BLIZL_HANDY_CONFIRM:-}" == yes ]]; then
          sudo setfacl -m "u:${current_uid}:r" /dev/input/event* 2>/dev/null || true
        fi
      fi
    fi
  fi
}

preflight() {
  local command
  for command in jq flock perl awk mktemp; do
    command -v "$command" >/dev/null || fail "required command not found: $command"
  done
  ensure_input_permissions
  [[ -f "$BINDINGS_FILE" ]] || fail "Hyprland bindings file not found: $BINDINGS_FILE"
  transaction_safe_target "$BINDINGS_FILE" || fail "bindings path resolves outside the supported user configuration roots"
  transaction_safe_target "$SETTINGS_FILE" || fail "Handy settings path resolves outside the supported user configuration roots"
  transaction_safe_target "$AUTOSTART_FILE" || fail "autostart path resolves outside the supported user configuration roots"
  [[ -f "$SHELL_FILE" ]] || fail "Omarchy shell settings file not found: $SHELL_FILE"
  transaction_safe_target "$SHELL_FILE" || fail "Omarchy shell path resolves outside the supported user configuration roots"
  jq -e . "$SHELL_FILE" >/dev/null || fail "Omarchy shell settings are malformed: $SHELL_FILE"
  transaction_safe_target "$VOXTYPE_CONFIG" || fail "VoxType config path resolves outside the supported user configuration roots"
  transaction_safe_target "$INSTALL_FILE" || fail "state path resolves outside the supported user configuration roots"
  if [[ "${BLIZL_HANDY_FORCE_INSTALL:-false}" == true ]] || ! command -v handy >/dev/null; then
    command -v "${BLIZL_HANDY_INSTALL_BIN:-yay}" >/dev/null || fail "Handy is absent and no AUR installer was found (install yay)"
  fi
  bindings_validate "$BINDINGS_FILE" || fail "Hyprland bindings file has an incomplete Handy managed block"
  omarchy plugin validate "$PLUGIN_ROOT"
}

install_handy() {
  if [[ "${BLIZL_HANDY_FORCE_INSTALL:-false}" != true ]] && command -v handy >/dev/null; then
    return 0
  fi
  if [[ "${BLIZL_HANDY_NONINTERACTIVE:-false}" != true && "${BLIZL_HANDY_FORCE_INSTALL:-false}" != true ]]; then
    say "Handy is not currently installed on your system."
    confirm "Install handy-bin from the AUR?" yes || fail "Handy installation was cancelled"
  fi
  say "Installing handy-bin from the AUR…"
  if [[ -n "${BLIZL_HANDY_INSTALL_BIN:-}" ]]; then
    "$BLIZL_HANDY_INSTALL_BIN" -S --needed --noconfirm handy-bin
  else
    yay -S --needed --noconfirm handy-bin
  fi
  HANDY_INSTALLED=true
}

launch_onboarding() {
  [[ "${BLIZL_HANDY_NONINTERACTIVE:-false}" == true ]] && return 0
  say "Opening Handy. Complete its official model onboarding, then return here."
  if command -v uwsm-app >/dev/null; then
    uwsm-app -- handy >/dev/null 2>&1 &
  else
    handy >/dev/null 2>&1 &
  fi
  read -r -p "Press Enter when Handy has a model ready… "
}

select_shortcut() {
  local voxtype_key choice custom
  if voxtype_is_available; then
    voxtype_key="$(bindings_detect_voxtype_key "$BINDINGS_FILE" "$VOXTYPE_BINDINGS_FILE")"
  else
    voxtype_key="$(bindings_detect_voxtype_key "$BINDINGS_FILE")"
  fi

  if [[ -n "${BLIZL_HANDY_SHORTCUT:-}" ]]; then
    SELECTED_SHORTCUT="$BLIZL_HANDY_SHORTCUT"
    return
  fi
  [[ -t 0 ]] || fail "set BLIZL_HANDY_SHORTCUT for non-interactive setup"

  say "Choose the dictation toggle shortcut:"
  if [[ -n "$voxtype_key" ]]; then
    say "  1. Reuse detected VoxType shortcut ($voxtype_key)"
  else
    say "  1. Reuse detected VoxType shortcut (none detected)"
  fi
  say "  2. Use ALT + SPACE"
  say "  3. Enter a custom shortcut"
  read -r -p "Selection [2]: " choice
  case "${choice:-2}" in
    1)
      [[ -n "$voxtype_key" ]] || fail "no active VoxType shortcut was detected"
      SELECTED_SHORTCUT="$voxtype_key"
      ;;
    2) SELECTED_SHORTCUT="ALT + SPACE" ;;
    3)
      read -r -p "Custom shortcut (Omarchy syntax): " custom
      SELECTED_SHORTCUT="$custom"
      ;;
    *) fail "invalid shortcut selection" ;;
  esac
}

# Only VoxType's own evdev hotkey, which lives in its TOML config and which
# setup can still turn off. A conflicting Hyprland binding is not something this
# plugin resolves any more; require_no_binding_conflict reports it instead.
voxtype_conflict_present() {
  local native_shortcut=''

  voxtype_is_available || return 1
  if [[ -f "$VOXTYPE_CONFIG" ]] && voxtype_hotkey_enabled "$VOXTYPE_CONFIG"; then
    if ! native_shortcut="$(voxtype_hotkey_shortcut "$VOXTYPE_CONFIG" 2>/dev/null)"; then
      fail "VoxType's native hotkey configuration is malformed"
    fi
    if [[ -n "$native_shortcut" ]] && voxtype_shortcuts_equal "$native_shortcut" "$SELECTED_SHORTCUT"; then
      return 0
    fi
  fi
  return 1
}

explain_voxtype_replacement() {
  voxtype_is_available || return 0

  say "Handy will replace VoxType as Omarchy's dictation engine while this plugin is installed."
  say "Setup disables VoxType's own hotkey and replaces the center Dictation indicator; it does not edit your Hyprland bindings."
  say "VoxType stays installed unless you remove it later; uninstall restores its previous controls."
}

confirm_voxtype_conflict() {
  voxtype_conflict_present || return 0

  say "Warning: VoxType dictation conflict on $SELECTED_SHORTCUT."
  say "Keeping VoxType and Handy on the same key makes one shortcut drive two engines, so a single press can start both transcribers."
  if [[ -n "${BLIZL_HANDY_CONFIRM_CONFLICT:-}" ]]; then
    [[ "$BLIZL_HANDY_CONFIRM_CONFLICT" == yes ]] ||
      fail "VoxType dictation conflict was not confirmed"
  elif [[ "${BLIZL_HANDY_NONINTERACTIVE:-false}" == true ]]; then
    fail "VoxType dictation conflict on $SELECTED_SHORTCUT; choose another shortcut or explicitly confirm Handy's takeover"
  else
    confirm "Let Handy take over $SELECTED_SHORTCUT and disable VoxType's matching hotkey?" no ||
      fail "VoxType dictation conflict was not confirmed"
  fi
  say "VoxType stays installed with its own hotkey disabled; uninstall restores it."
}

confirm_voxtype_removal() {
  if [[ -n "${BLIZL_HANDY_REMOVE_VOXTYPE:-}" ]]; then
    [[ "$BLIZL_HANDY_REMOVE_VOXTYPE" == yes ]]
    return
  fi
  [[ "${BLIZL_HANDY_NONINTERACTIVE:-false}" != true ]] || return 1
  confirm "Handy passed. Remove VoxType?" no
}

confirm_configuration_plan() {
  say ""
  say "Configuration Summary:"
  say "  • Hyprland: No change; $BINDINGS_FILE is never modified"
  say "  • Handy: Set dictation toggle shortcut to $SELECTED_SHORTCUT in $SETTINGS_FILE"
  say "  • Autostart: Ensure Handy launches hidden on login ($AUTOSTART_FILE)"
  say "  • Omarchy Bar: Replace Dictation indicator with Handy widget in $SHELL_FILE"
  if voxtype_is_available && [[ -f "$VOXTYPE_CONFIG" ]] && voxtype_hotkey_enabled "$VOXTYPE_CONFIG"; then
    say "  • VoxType: Disable conflicting native dictation hotkey in $VOXTYPE_CONFIG"
  fi
  say "  (All target files are snapshotted in an atomic transaction and fully restored on uninstall.)"
  say ""
  if [[ "${BLIZL_HANDY_NONINTERACTIVE:-false}" != true ]]; then
    confirm "Apply these configuration changes?" yes || fail "setup cancelled by user"
  fi
}

# blizl.handy never edits bindings.lua. Handy reads the chord straight from
# /dev/input/event*, so a compositor binding on the same chord is not shadowed:
# both actions fire on one press. Report the exact line and stop, rather than
# rewriting a file that Hyprland executes as Lua.
show_conflicting_binding() {
  local bindings_file="$1" key="$2" located line text

  located="$(bindings_locate_key "$bindings_file" "$key" || true)"
  if [[ -n "$located" ]]; then
    line="${located%%$'\t'*}"
    text="${located#*$'\t'}"
    say "  $bindings_file:$line"
    say "      ${text#"${text%%[![:space:]]*}"}"
  else
    say "  $bindings_file"
  fi
}

# Return the file's own spelling of any bound key that means the same chord as
# the selected shortcut. Comparing literally would miss "ALT+ENTER" when the
# file says "ALT + ENTER", and a missed conflict is a silent double-trigger.
conflicting_bound_key() {
  local bindings_file="$1" candidate
  while IFS= read -r candidate; do
    [[ -n "$candidate" ]] || continue
    if voxtype_shortcuts_equal "$candidate" "$SELECTED_SHORTCUT"; then
      printf '%s\n' "$candidate"
      return 0
    fi
  done < <(bindings_all_keys "$bindings_file")
  return 1
}

require_no_binding_conflict() {
  local existing bound_key

  if bound_key="$(conflicting_bound_key "$BINDINGS_FILE")"; then
    existing="$(bindings_action_for_key "$BINDINGS_FILE" "$bound_key")"
    say ""
    say "$SELECTED_SHORTCUT is already bound in your Hyprland configuration:"
    show_conflicting_binding "$BINDINGS_FILE" "$bound_key"
    [[ -n "$existing" ]] && say "      action: $existing"
    say ""
    say "Handy reads the shortcut directly from the kernel, so that binding would"
    say "still fire alongside Handy and one press would trigger both actions."
    say "Remove or change that line, then run setup again."
    fail "$SELECTED_SHORTCUT is already bound in $BINDINGS_FILE"
  fi

  voxtype_is_available || return 0
  bound_key="$(conflicting_bound_key "$VOXTYPE_BINDINGS_FILE")" || return 0
  say ""
  say "$SELECTED_SHORTCUT is bound by Omarchy's stock VoxType bindings:"
  show_conflicting_binding "$VOXTYPE_BINDINGS_FILE" "$bound_key"
  say ""
  say "That file belongs to Omarchy, so override it from your own configuration by"
  say "adding this line to $BINDINGS_FILE, then run setup again:"
  say ""
  say "  hl.unbind(\"$SELECTED_SHORTCUT\")"
  fail "$SELECTED_SHORTCUT is bound by Omarchy's stock VoxType bindings"
}

# Bindings on other keys are not a conflict with Handy, but they do keep VoxType
# reachable, so name them instead of silently unbinding them as v1 did.
warn_other_voxtype_bindings() {
  local key found=false
  voxtype_is_available || return 0
  while IFS= read -r key; do
    [[ -n "$key" ]] || continue
    voxtype_shortcuts_equal "$key" "$SELECTED_SHORTCUT" && continue
    if [[ "$found" != true ]]; then
      say ""
      say "These Hyprland bindings still start VoxType. Handy does not touch them;"
      say "remove them yourself if you want Handy to be the only dictation engine:"
      found=true
    fi
    say "  $key"
  done < <(bindings_detect_voxtype_keys "$BINDINGS_FILE" "$VOXTYPE_BINDINGS_FILE")
}

configure_handy_binding() {
  if pgrep -x handy >/dev/null 2>&1; then
    HANDY_WAS_RUNNING=true
    pkill -x handy || true
    for _ in {1..30}; do
      pgrep -x handy >/dev/null 2>&1 || break
      sleep 0.1
    done
  fi
  handy_settings_set_shortcut "$SETTINGS_FILE" "$SELECTED_SHORTCUT"
  local expected_binding
  expected_binding="$(handy_shortcut_normalize "$SELECTED_SHORTCUT")"
  [[ "$(handy_settings_binding "$SETTINGS_FILE")" == "$expected_binding" ]] ||
    fail "Handy did not retain the dictation shortcut ($expected_binding)"
  [[ "$(handy_settings_keyboard_implementation "$SETTINGS_FILE")" == "handy_keys" ]] ||
    fail "Handy did not configure native handy_keys keyboard implementation"
  # Toggle mode: one press starts recording, the next press stops it. Handy
  # spells that as push_to_talk = false.
  [[ "$(handy_settings_push_to_talk "$SETTINGS_FILE")" == "false" ]] ||
    fail "Handy did not enable toggle mode"
}

configure_voxtype_hotkey() {
  local disable_status=0
  voxtype_is_available || return 0
  [[ -f "$VOXTYPE_CONFIG" ]] || return 0

  voxtype_hotkey_disable "$VOXTYPE_CONFIG" || disable_status=$?
  case "$disable_status" in
    "$VOXTYPE_SETTINGS_CHANGED")
      VOXTYPE_HOTKEY_DISABLED=true
      say "Keeping VoxType installed, but disabling its native hotkey for Handy. Uninstall restores VoxType's original hotkey."
      if command -v systemctl >/dev/null 2>&1 && systemctl --user is-active voxtype.service >/dev/null 2>&1; then
        VOXTYPE_WAS_ACTIVE=true
        systemctl --user restart voxtype.service >/dev/null
      fi
      ;;
    "$VOXTYPE_SETTINGS_NO_CHANGE") ;;
    *) fail "VoxType's native hotkey configuration is malformed" ;;
  esac
}

configure_autostart() {
  local temporary
  mkdir -p -- "$(dirname -- "$AUTOSTART_FILE")"
  if [[ -f "$AUTOSTART_FILE" ]]; then
    temporary="$(mktemp "${AUTOSTART_FILE}.tmp.XXXXXX")"
    awk '
      /^Exec=/ { if (!found) print "Exec=handy --start-hidden"; found = 1; next }
      { print }
      END { if (!found) print "Exec=handy --start-hidden" }
    ' "$AUTOSTART_FILE" >"$temporary"
    chmod --reference="$AUTOSTART_FILE" "$temporary"
    mv -- "$temporary" "$AUTOSTART_FILE"
  else
    cat >"$AUTOSTART_FILE" <<'DESKTOP'
[Desktop Entry]
Type=Application
Version=1.0
Name=Handy
Comment=Start Handy hidden for toggle dictation
Exec=handy --start-hidden
StartupNotify=false
Terminal=false
DESKTOP
  fi
}

configure_shell_widget() {
  shell_settings_install_handy_widget "$SHELL_FILE" ||
    fail "could not replace the built-in Dictation indicator in Omarchy shell settings"
  say "Replaced the built-in Dictation indicator with Handy in the center section."
}

validate_reload() {
  [[ "${BLIZL_HANDY_SKIP_RELOAD:-false}" == true ]] && return 0
  if command -v omarchy >/dev/null 2>&1; then
    omarchy restart shell >/dev/null 2>&1 || true
  fi
  if [[ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]] && command -v hyprctl >/dev/null; then
    hyprctl reload >/dev/null
    local errors
    errors="$(hyprctl configerrors)"
    [[ -z "$errors" ]] || fail "Hyprland configuration errors: $errors"
  fi
}

start_handy_hidden() {
  handy --start-hidden >/dev/null 2>&1 &
  HANDY_STARTED_BY_SETUP=true
  for _ in {1..30}; do
    pgrep -x handy >/dev/null 2>&1 && return 0
    sleep 0.1
  done
  fail "Handy did not start"
}

plugin_checkout_present() {
  local installed_root
  installed_root="$HOME/.config/omarchy/plugins/blizl.handy"
  [[ -e "$installed_root" || -L "$installed_root" ]] || return 1
  [[ "$(realpath -m -- "$PLUGIN_ROOT")" == "$(realpath -m -- "$installed_root")" ]]
}

plugin_is_installed_checkout() {
  [[ -n "${BLIZL_HANDY_PLUGIN_REMOVE_BIN:-}" ]] && return 0
  plugin_checkout_present
}

remove_plugin_after_failed_test() {
  plugin_is_installed_checkout || return 0
  say "Dictation did not pass; removing the blizl.handy plugin."
  if [[ -n "${BLIZL_HANDY_PLUGIN_REMOVE_BIN:-}" ]]; then
    "$BLIZL_HANDY_PLUGIN_REMOVE_BIN" blizl.handy --yes
  else
    omarchy plugin remove blizl.handy --yes
  fi
  if plugin_checkout_present; then
    printf 'Plugin removal did not complete; the installed checkout remains.\n' >&2
    return 1
  fi
}

run_dictation_test_window() {
  local test_directory result_file pid_file result line_count launch_status helper_pid=''
  test_directory="$(mktemp -d "$STATE_ROOT/dictation-test.XXXXXX")"
  TEST_WINDOW_DIR="$test_directory"
  result_file="$test_directory/result"
  pid_file="$test_directory/helper.pid"
  TEST_WINDOW_PID_FILE="$pid_file"

  say "Testing the Handy dictation toggle in this terminal."
  local test_bin="${BLIZL_HANDY_TEST_WINDOW_BIN:-$PLUGIN_ROOT/bin/handy-test-window}"
  launch_status=0
  BLIZL_HANDY_TEST_PID_FILE="$pid_file" \
    "$test_bin" "$result_file" "$SELECTED_SHORTCUT" || launch_status=$?

  if [[ -f "$pid_file" ]]; then
    helper_pid="$(<"$pid_file")"
    if [[ "$helper_pid" =~ ^[0-9]+$ && "$helper_pid" != "$$" ]]; then
      kill "$helper_pid" >/dev/null 2>&1 || true
      wait "$helper_pid" >/dev/null 2>&1 || true
    fi
  fi
  result=''
  line_count=0
  if [[ -f "$result_file" ]]; then
    result="$(<"$result_file")"
    line_count="$(wc -l <"$result_file")"
  fi
  rm -rf -- "$test_directory"
  TEST_WINDOW_DIR=''
  TEST_WINDOW_PID_FILE=''

  ((launch_status == 0)) && [[ "$result" == passed ]] && [[ "$line_count" == 1 ]]
}

dictation_test() {
  [[ "${BLIZL_HANDY_DICTATION_TEST:-}" == passed ]] && return 0
  if [[ "${BLIZL_HANDY_NONINTERACTIVE:-false}" == true && -z "${BLIZL_HANDY_TEST_WINDOW_BIN:-}" ]]; then
    fail "a dictation test is required before setup can commit"
  fi
  DICTATION_TEST_STARTED=true
  say "Now test Handy dictation: press $SELECTED_SHORTCUT, speak one sentence, then press it again to stop."
  run_dictation_test_window || fail "dictation test did not produce text"
}

maybe_remove_voxtype() {
  local recovery path relative enabled active
  pacman -Q voxtype-bin >/dev/null 2>&1 || return 0
  confirm_voxtype_removal || return 0

  recovery="$STATE_ROOT/voxtype-recovery/$(date -u +%Y%m%dT%H%M%SZ)"
  VOXTYPE_RECOVERY="$recovery"
  mkdir -p -- "$recovery"
  enabled="disabled"
  active="inactive"
  if command -v systemctl >/dev/null 2>&1; then
    enabled="$(systemctl --user is-enabled voxtype.service 2>/dev/null || printf disabled)"
    active="$(systemctl --user is-active voxtype.service 2>/dev/null || printf inactive)"
  fi
  jq -n --arg enabled "$enabled" --arg active "$active" '{enabled:$enabled,active:$active}' >"$recovery/service-state.json"
  VOXTYPE_RECOVERY_ACTIVE=true
  for path in "$HOME/.config/systemd/user/voxtype.service" "$HOME/.config/voxtype" "$HOME/.local/share/voxtype"; do
    if [[ -e "$path" ]]; then
      relative="${path#/}"
      mkdir -p -- "$recovery/files/$(dirname -- "$relative")"
      cp -a --reflink=auto -- "$path" "$recovery/files/$relative"
    fi
  done
  systemctl --user disable --now voxtype.service >/dev/null 2>&1 || true
  if [[ -n "${BLIZL_HANDY_VOXTYPE_REMOVE_BIN:-}" ]]; then
    "$BLIZL_HANDY_VOXTYPE_REMOVE_BIN" voxtype-bin
  elif [[ -n "${BLIZL_HANDY_PKG_DROP_BIN:-}" ]]; then
    "$BLIZL_HANDY_PKG_DROP_BIN" voxtype-bin
  elif command -v omarchy >/dev/null 2>&1; then
    omarchy pkg drop voxtype-bin
  fi
  VOXTYPE_REMOVED=true
  systemctl --user daemon-reload
}

voxtype_restore() {
  local path relative enabled active
  [[ -n "$VOXTYPE_RECOVERY" && -d "$VOXTYPE_RECOVERY" ]] || return 1
  if [[ -n "${BLIZL_HANDY_VOXTYPE_INSTALL_BIN:-}" ]]; then
    "$BLIZL_HANDY_VOXTYPE_INSTALL_BIN" voxtype-bin
  elif [[ -n "${BLIZL_HANDY_PKG_ADD_BIN:-}" ]]; then
    "$BLIZL_HANDY_PKG_ADD_BIN" voxtype-bin
  elif command -v omarchy >/dev/null 2>&1; then
    omarchy pkg add voxtype-bin
  fi
  while IFS= read -r path; do
    relative="${path#/}"
    if [[ -e "$VOXTYPE_RECOVERY/files/$relative" || -L "$VOXTYPE_RECOVERY/files/$relative" ]]; then
      rm -rf -- "$path"
      mkdir -p -- "$(dirname -- "$path")"
      cp -a --reflink=auto -- "$VOXTYPE_RECOVERY/files/$relative" "$path"
    fi
  done < <(printf '%s\n' "$HOME/.config/systemd/user/voxtype.service" "$HOME/.config/voxtype" "$HOME/.local/share/voxtype")
  enabled="$(jq -r '.enabled' "$VOXTYPE_RECOVERY/service-state.json")"
  active="$(jq -r '.active' "$VOXTYPE_RECOVERY/service-state.json")"
  if [[ "$enabled" == enabled ]]; then
    systemctl --user enable voxtype.service
    if [[ "$active" == active ]]; then
      systemctl --user start voxtype.service
    else
      systemctl --user stop voxtype.service
    fi
  else
    systemctl --user disable --now voxtype.service
  fi
  systemctl --user daemon-reload
  VOXTYPE_REMOVED=false
}

main() {
  local installed_version

  preflight
  mkdir -p -- "$STATE_ROOT"
  if [[ -f "$INSTALL_FILE" ]]; then
    jq -e '.transaction and .shortcut' "$INSTALL_FILE" >/dev/null || fail "existing setup record is malformed"
    installed_version="$(jq -r '.version // 1' "$INSTALL_FILE")"
    case "$installed_version" in
      2)
        say "Handy dictation is already configured; leaving its managed integration unchanged."
        return 0
        ;;
      1)
        say "Upgrading the existing Handy integration to the conflict-safe setup."
        "$PLUGIN_ROOT/bin/uninstall"
        ;;
      *) fail "unsupported existing setup version: $installed_version" ;;
    esac
  fi

  transaction_begin "$STATE_ROOT"
  CREATED_TRANSACTION=true
  # bindings.lua is deliberately absent: setup never writes it, so restoring a
  # snapshot on uninstall would only clobber edits made in the meantime.
  transaction_backup "$SETTINGS_FILE"
  transaction_backup "$AUTOSTART_FILE"
  transaction_backup "$SHELL_FILE"
  transaction_backup "$VOXTYPE_CONFIG"
  transaction_backup "$INSTALL_FILE"

  install_handy
  launch_onboarding
  [[ -f "$SETTINGS_FILE" ]] || fail "Handy settings do not exist; finish onboarding first"
  select_shortcut
  require_no_binding_conflict
  warn_other_voxtype_bindings
  explain_voxtype_replacement
  confirm_voxtype_conflict
  confirm_configuration_plan
  configure_voxtype_hotkey
  configure_handy_binding
  configure_autostart
  configure_shell_widget
  validate_reload
  start_handy_hidden
  local expected_binding
  expected_binding="$(handy_shortcut_normalize "$SELECTED_SHORTCUT")"
  [[ "$(handy_settings_binding "$SETTINGS_FILE")" == "$expected_binding" ]] || fail "Handy did not register the dictation shortcut"
  dictation_test

  jq -n \
    --arg version "2" \
    --arg transaction "$TRANSACTION_DIR" \
    --arg shortcut "$SELECTED_SHORTCUT" \
    --arg handyBinding "$expected_binding" \
    --argjson handyInstalled "$HANDY_INSTALLED" \
    --argjson voxtypeHotkeyDisabled "$VOXTYPE_HOTKEY_DISABLED" \
    --arg installedAt "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
    '{version: ($version | tonumber), transaction: $transaction, shortcut: $shortcut, handyBinding: $handyBinding, handyInstalled: $handyInstalled, voxtypeHotkeyDisabled: $voxtypeHotkeyDisabled, installedAt: $installedAt}' \
    >"$INSTALL_FILE"
  maybe_remove_voxtype
  COMMITTED=true
  say "Handy dictation setup complete. Toggle shortcut: $SELECTED_SHORTCUT"
}

main "$@"
